# ============================================================
# CobData Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ─── App ─────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Database (PostgreSQL) ───────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_USER=cobdata
DB_PASSWORD=cobdata123
DB_NAME=cobdata
DATABASE_URL=postgresql://cobdata:cobdata123@localhost:5433/cobdata

# ─── Redis ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-secure-random-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── S3 / MinIO ─────────────────────────────────────────────
S3_ENDPOINT=localhost
S3_PORT=9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=cobdata-imports
S3_USE_SSL=false

# ─── Serasa LNOP ────────────────────────────────────────────
SERASA_API_URL=https://api-homolog.serasaexperian.com.br
SERASA_API_KEY=
SERASA_WEBHOOK_SECRET=
SERASA_TIMEOUT=30000

# ─── Seed ────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@cobdata.local
SEED_ADMIN_PASSWORD=Admin@123
