// ============================================================
// CobData Backend — Prisma Schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============

enum Role {
  ADMIN
  OPERATIONAL
  VIEWER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum WalletStatus {
  ACTIVE
  INACTIVE
}

enum DebtType {
  COMMERCIAL
  BANKING
  SERVICES
  UTILITIES
  TELECOM
  EDUCATION
  HEALTH
  CONDOMINIAL
  OTHER
}

enum SerasaStatus {
  NOT_ENABLED
  PENDING
  SENT
  REGISTERED
  UPDATED
  FAILED
  REMOVING
  REMOVED
}

enum PaymentStatus {
  OPEN
  IN_AGREEMENT
  INSTALLMENT
  AGREEMENT_BREACHED
  PAID
}

enum ContractStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum ImportBatchStatus {
  PENDING_VALIDATION
  VALIDATING
  VALIDATED
  VALIDATED_WITH_ERRORS
  VALIDATION_FAILED
  APPLYING
  APPLIED
  FAILED
  CANCELLED
}

enum ProviderType {
  SERASA_LNOP
}

enum ProviderEnv {
  HOMOLOGATION
  PRODUCTION
}

enum OperationAction {
  CREATE_OR_UPDATE
  REMOVE
}

enum OperationStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIALLY_FAILED
  FAILED
  CANCELLED
}

enum OperationItemStatus {
  PENDING
  WAITING_PROVIDER_EVENT
  REGISTERED
  UPDATED
  REMOVED
  FAILED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  UNMATCHED
  DUPLICATE
}

enum InteractionChannel {
  AI_VOICE_CALL
  SMS
  WHATSAPP
  EMAIL
}

enum InteractionStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  ANSWERED
  COMPLETED
  FAILED
  NO_ANSWER
  REJECTED
}

enum WhatsAppBotState {
  AWAITING_CPF
  AWAITING_NAME
  AWAITING_ACTION
}

enum ApiKeyScope {
  CONTRACTS_READ
  CONTRACTS_WRITE
  CONTRACT_CONTACTS_WRITE
  PIX_CREATE
}

// ============ CORE ============

model Account {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                    User[]
  creditors                Creditor[]
  wallets                  Wallet[]
  serasaWallets            SerasaWallet[]
  contracts                Contract[]
  providers                Provider[]
  importBatches            ImportBatch[]
  providerOperations       ProviderOperation[]
  paymentGateways          PaymentGateway[]
  paymentCharges           PaymentCharge[]
  paymentSettlements       PaymentSettlement[]
  whatsAppBotConversations WhatsAppBotConversation[]
  ligueLeadAgents          LigueLeadWalletAgent[]
  ligueLeadDispatches      LigueLeadDispatch[]
  ligueLeadWebhookEvents   LigueLeadWebhookEvent[]
  contractInteractions     ContractInteraction[]
  apiKeys                  ApiKey[]
}

model ApiKey {
  id          String        @id @default(uuid())
  accountId   String
  creditorId  String?
  accessAllCreditors Boolean @default(false)
  name        String
  tokenPrefix String
  tokenHash   String        @unique
  scopes      ApiKeyScope[]
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  account  Account  @relation(fields: [accountId], references: [id])
  creditor Creditor? @relation(fields: [creditorId], references: [id])

  @@index([accountId, revokedAt])
  @@index([creditorId, revokedAt])
}

model User {
  id                String   @id @default(uuid())
  accountId         String
  email             String   @unique
  passwordHash      String?
  name              String?
  role              Role
  isActive          Boolean  @default(false)
  mustResetPassword Boolean  @default(false)
  twoFactorSecret   String?
  twoFactorEnabled  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  account             Account             @relation(fields: [accountId], references: [id])
  scopes              UserScope[]
  sessions            Session[]
  invites             Invite[]
  auditLogs           AuditLog[]
  providerOperations  ProviderOperation[]
  ligueLeadDispatches LigueLeadDispatch[]
}

model UserScope {
  id       String @id @default(uuid())
  userId   String
  walletId String

  user   User   @relation(fields: [userId], references: [id])
  wallet Wallet @relation(fields: [walletId], references: [id])

  @@unique([userId, walletId])
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  tokenFamily      String   @unique @default(uuid())
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  isRevoked        Boolean  @default(false)
  createdAt        DateTime @default(now())
  expiresAt        DateTime
  lastUsedAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Invite {
  id        String       @id @default(uuid())
  userId    String
  token     String       @unique
  role      Role
  scopes    Json?
  status    InviteStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ============ BUSINESS ============

model Creditor {
  id        String    @id @default(uuid())
  accountId String
  name      String
  cnpj      String?   @unique
  contacts  Json?
  address   Json?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  account Account  @relation(fields: [accountId], references: [id])
  wallets Wallet[]
  apiKeys ApiKey[]
}

model Wallet {
  id             String       @id @default(uuid())
  accountId      String
  creditorId     String
  serasaWalletId String?
  isApiDefault   Boolean      @default(false)
  name           String
  status         WalletStatus @default(ACTIVE)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  account              Account               @relation(fields: [accountId], references: [id])
  creditor             Creditor              @relation(fields: [creditorId], references: [id])
  serasaWallet         SerasaWallet?         @relation(fields: [serasaWalletId], references: [id])
  contracts            Contract[]
  importBatches        ImportBatch[]
  userScopes           UserScope[]
  walletMappings       WalletMapping[]
  providerOperations   ProviderOperation[]
  ligueLeadAgent       LigueLeadWalletAgent?
  ligueLeadDispatches  LigueLeadDispatch[]
  contractInteractions ContractInteraction[]
}

model LigueLeadWalletAgent {
  id           String   @id @default(uuid())
  accountId    String
  walletId     String   @unique
  externalId   String   @unique
  name         String
  prompt       String   @db.Text
  greetings    String?
  modelVersion String   @default("lumen-1")
  voiceId      String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id])
  wallet  Wallet  @relation(fields: [walletId], references: [id])
}

model LigueLeadDispatch {
  id         String   @id @default(uuid())
  accountId  String
  walletId   String
  userId     String
  type       String
  title      String
  externalId String?
  totalItems Int
  createdAt  DateTime @default(now())

  account Account                 @relation(fields: [accountId], references: [id])
  wallet  Wallet                  @relation(fields: [walletId], references: [id])
  user    User                    @relation(fields: [userId], references: [id])
  items   LigueLeadDispatchItem[]

  @@index([walletId, createdAt])
}

model LigueLeadDispatchItem {
  id                 String    @id @default(uuid())
  dispatchId         String
  contractId         String
  externalCampaignId String?
  phone              String
  status             String    @default("PENDING")
  durationSeconds    Int?
  recordingUrl       String?
  transcript         Json?
  actionExecuted     String?
  rawPayload         Json?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  dispatch LigueLeadDispatch @relation(fields: [dispatchId], references: [id])
  contract Contract          @relation(fields: [contractId], references: [id])

  @@unique([dispatchId, contractId])
  @@index([externalCampaignId, phone])
}

model LigueLeadWebhookEvent {
  id        String   @id @default(uuid())
  accountId String
  eventKey  String   @unique
  event     String
  payload   Json
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id])
}

// Recebimentos autenticados preservados antes da associação a um contrato.
// Permite diagnosticar e evoluir formatos de webhook do provedor sem perder dados.
model LigueLeadWebhookReceipt {
  id        String   @id @default(uuid())
  event     String?
  payload   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Registro imutável das tentativas e retornos de contato por contrato.
// Novos provedores (e-mail, WhatsApp, SMS etc.) usam a mesma estrutura.
model ContractInteraction {
  id           String             @id @default(uuid())
  accountId    String
  walletId     String
  contractId   String
  channel      InteractionChannel
  status       InteractionStatus  @default(QUEUED)
  provider     String?
  externalId   String?
  contact      String?
  summary      String?            @db.Text
  conversation Json?
  recordingUrl String?
  payload      Json?
  occurredAt   DateTime           @default(now())
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  account  Account  @relation(fields: [accountId], references: [id])
  wallet   Wallet   @relation(fields: [walletId], references: [id])
  contract Contract @relation(fields: [contractId], references: [id])

  @@index([contractId, occurredAt])
  @@index([walletId, channel, status])
  @@index([provider, externalId])
}

model WhatsAppBotConversation {
  id                      String           @id @default(uuid())
  accountId               String
  conversationKey         String           @unique
  chatwootConversationId  String?          @unique
  debtorDocumentEncrypted String?
  contracts               Json?
  state                   WhatsAppBotState @default(AWAITING_CPF)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  account  Account              @relation(fields: [accountId], references: [id])
  messages WhatsAppBotMessage[]

  @@index([accountId, updatedAt])
}

model WhatsAppBotMessage {
  id                String   @id @default(uuid())
  conversationId    String
  externalMessageId String   @unique
  response          String
  createdAt         DateTime @default(now())

  conversation WhatsAppBotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Contract {
  id                      String         @id @default(uuid())
  accountId               String
  walletId                String
  debtorDocument          String
  debtorDocumentHash      String
  debtorName              String         @default("")
  contractNumber          String
  debtType                DebtType
  occurrenceDate          DateTime
  dueDate                 DateTime?
  originalValue           Decimal        @db.Decimal(15, 2)
  updatedValue            Decimal        @db.Decimal(15, 2)
  debtOrigin              String?
  debtOriginDocHash       String?
  productName             String?
  debtorStreet            String?
  debtorCity              String?
  debtorPhone             String?
  debtorEmail             String?
  debtorAddressNumber     String?
  debtorAddressComplement String?
  debtorNeighborhood      String?
  debtorState             String?
  debtorZipCode           String?
  isNegativated           Boolean        @default(false)
  cancelledAt             DateTime?
  offer                   Json?
  deduplicationKey        String         @unique
  serasaStatus            SerasaStatus   @default(NOT_ENABLED)
  paymentStatus           PaymentStatus  @default(OPEN)
  status                  ContractStatus @default(ACTIVE)
  debtId                  String?
  agreementReference      String?
  agreementTotalAmount    Decimal?       @db.Decimal(15, 2)
  totalInstallments       Int?
  paidInstallments        Int            @default(0)
  totalPaidAmount         Decimal        @default(0) @db.Decimal(15, 2)
  lastPaymentAt           DateTime?
  deletedAt               DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  account                Account                 @relation(fields: [accountId], references: [id])
  wallet                 Wallet                  @relation(fields: [walletId], references: [id])
  tags                   ContractTag[]
  operationItems         ProviderOperationItem[]
  paymentCharges         PaymentCharge[]
  paymentSettlements     PaymentSettlement[]
  ligueLeadDispatchItems LigueLeadDispatchItem[]
  interactions           ContractInteraction[]

  @@index([walletId, serasaStatus])
  @@index([walletId, paymentStatus])
  @@index([walletId, totalInstallments])
  @@index([walletId, status, deletedAt])
  @@index([debtorDocumentHash])
}

model ContractTag {
  id         String @id @default(uuid())
  contractId String
  tag        String

  contract Contract @relation(fields: [contractId], references: [id])

  @@unique([contractId, tag])
  @@index([tag])
}

// ============ IMPORTS ============

model ImportBatch {
  id            String            @id @default(uuid())
  accountId     String
  walletId      String
  userId        String
  fileName      String
  fileUrl       String
  columnMapping Json
  totalLines    Int
  validLines    Int               @default(0)
  invalidLines  Int               @default(0)
  createdCount  Int               @default(0)
  updatedCount  Int               @default(0)
  ignoredCount  Int               @default(0)
  status        ImportBatchStatus @default(PENDING_VALIDATION)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  account Account            @relation(fields: [accountId], references: [id])
  wallet  Wallet             @relation(fields: [walletId], references: [id])
  errors  ImportBatchError[]
}

model ImportBatchError {
  id         String  @id @default(uuid())
  batchId    String
  lineNumber Int
  errorCode  String
  fieldName  String
  message    String
  fieldValue String?

  batch ImportBatch @relation(fields: [batchId], references: [id])

  @@index([batchId])
}

// ============ PROVIDERS ============

model Provider {
  id          String       @id @default(uuid())
  accountId   String
  type        ProviderType @unique
  environment ProviderEnv
  credentials String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  account        Account             @relation(fields: [accountId], references: [id])
  walletMappings WalletMapping[]
  operations     ProviderOperation[]
  webhookEvents  WebhookEvent[]
}

model WalletMapping {
  id               String @id @default(uuid())
  providerId       String
  walletId         String
  externalWalletId String

  provider Provider @relation(fields: [providerId], references: [id])
  wallet   Wallet   @relation(fields: [walletId], references: [id])

  @@unique([providerId, walletId])
}

model SerasaWallet {
  id               String   @id @default(uuid())
  accountId        String
  externalWalletId String
  name             String
  criteria         String?  @db.Text
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  account    Account  @relation(fields: [accountId], references: [id])
  crmWallets Wallet[]

  @@unique([accountId, externalWalletId])
  @@index([accountId])
}

model ProviderOperation {
  id         String          @id @default(uuid())
  accountId  String
  providerId String
  walletId   String
  userId     String
  action     OperationAction
  status     OperationStatus @default(PENDING)
  totalItems Int
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  account  Account                 @relation(fields: [accountId], references: [id])
  provider Provider                @relation(fields: [providerId], references: [id])
  wallet   Wallet                  @relation(fields: [walletId], references: [id])
  user     User                    @relation(fields: [userId], references: [id])
  items    ProviderOperationItem[]
}

model ProviderOperationItem {
  id            String              @id @default(uuid())
  operationId   String
  contractId    String
  batchIndex    Int
  status        OperationItemStatus @default(PENDING)
  transactionId String?
  debtId        String?
  errorCode     String?
  errorMessage  String?
  attempts      Int                 @default(0)
  lastAttemptAt DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  operation ProviderOperation @relation(fields: [operationId], references: [id])
  contract  Contract          @relation(fields: [contractId], references: [id])

  @@index([operationId, batchIndex])
  @@index([transactionId])
}

model WebhookEvent {
  id            String        @id @default(uuid())
  providerId    String
  eventType     String
  transactionId String?
  payload       Json
  status        WebhookStatus @default(RECEIVED)
  processedAt   DateTime?
  createdAt     DateTime      @default(now())

  provider Provider @relation(fields: [providerId], references: [id])

  @@unique([transactionId, eventType])
  @@index([transactionId])
}

// ============ PAYMENTS ============

enum PaymentProviderType {
  BANCO_DO_BRASIL
}

enum PaymentMethod {
  BOLETO
  PIX
  BOLEPIX
}

enum PaymentGatewayEnvironment {
  SANDBOX
  PRODUCTION
}

enum PaymentChargeStatus {
  PENDING
  ISSUED
  PAID
  CANCELLED
  EXPIRED
  FAILED
}

enum PaymentChargeChannel {
  COBCOM
  LANDING_PAGE
  WHATSAPP
  CHATBOT
}

enum PaymentSettlementSource {
  PIX
  SERASA
  MANUAL
}

enum PaymentSettlementStatus {
  CONFIRMED
  REVERSED
}

model PaymentGateway {
  id                   String                    @id @default(uuid())
  accountId            String
  name                 String
  providerType         PaymentProviderType
  environment          PaymentGatewayEnvironment
  enabled              Boolean                   @default(false)
  supportedMethods     PaymentMethod[]
  pixKey               String?
  encryptedCredentials String                    @db.Text
  timeoutMs            Int                       @default(30000)
  maxRetries           Int                       @default(3)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  account        Account         @relation(fields: [accountId], references: [id])
  paymentCharges PaymentCharge[]

  @@unique([accountId, providerType, environment])
}

model PaymentCharge {
  id                String                @id @default(uuid())
  accountId         String
  contractId        String
  paymentGatewayId  String
  method            PaymentMethod
  status            PaymentChargeStatus   @default(PENDING)
  amount            Decimal               @db.Decimal(15, 2)
  dueDate           DateTime
  idempotencyKey    String
  externalId        String?
  externalStatus    String?
  ourNumber         String?
  txid              String?
  digitableLine     String?
  barcode           String?
  pixCopyPaste      String?
  qrCodeUrl         String?
  documentUrl       String?
  providerPayload   Json?
  failureCode       String?
  failureMessage    String?
  issuedAt          DateTime?
  paidAt            DateTime?
  expiresAt         DateTime?
  attributedChannel PaymentChargeChannel?
  version           Int                   @default(1)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  account            Account             @relation(fields: [accountId], references: [id])
  contract           Contract            @relation(fields: [contractId], references: [id])
  paymentGateway     PaymentGateway      @relation(fields: [paymentGatewayId], references: [id])
  paymentEvents      PaymentEvent[]
  paymentSettlements PaymentSettlement[]

  @@unique([idempotencyKey, paymentGatewayId])
  @@index([contractId, status])
  @@index([status, expiresAt])
  @@index([status, dueDate])
  @@index([txid])
}

model PaymentEvent {
  id              String   @id @default(uuid())
  paymentChargeId String
  fromStatus      String?
  toStatus        String
  source          String
  metadata        Json?
  createdAt       DateTime @default(now())

  paymentCharge PaymentCharge @relation(fields: [paymentChargeId], references: [id])

  @@index([paymentChargeId, createdAt])
}

model PaymentSettlement {
  id                 String                  @id @default(uuid())
  accountId          String
  contractId         String
  paymentChargeId    String?
  agreementReference String?
  installmentNumber  Int?
  source             PaymentSettlementSource
  status             PaymentSettlementStatus @default(CONFIRMED)
  amount             Decimal                 @db.Decimal(15, 2)
  paidAt             DateTime
  externalPaymentId  String
  channelEventId     String?
  debtReference      String?
  metadata           Json?
  providerPayload    Json?
  createdAt          DateTime                @default(now())

  account       Account        @relation(fields: [accountId], references: [id])
  contract      Contract       @relation(fields: [contractId], references: [id])
  paymentCharge PaymentCharge? @relation(fields: [paymentChargeId], references: [id])

  @@unique([source, externalPaymentId])
  @@index([contractId])
}

// ============ AUDIT ============

model AuditLog {
  id           String   @id @default(uuid())
  action       String
  userId       String?
  resourceType String?
  resourceId   String?
  requestId    String
  operationId  String?
  jobId        String?
  ipAddress    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([action, createdAt])
  @@index([userId, createdAt])
  @@index([resourceType, resourceId])
  @@index([requestId])
}
